# Build
target/

# Plugin build artifacts inside local test servers — produced by `mvn package`,
# 256 MB each (shaded Ignite) → exceed GitHub's 100 MB hard limit.
Servers/**/plugins/buildbattleai-*.jar
# Paper auto-generated remap cache — regenerated on server start.
Servers/**/.paper-remapped/

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Keystores (JAR signing)
*.jks
*.p12

# Large ML models (exceed GitHub 100 MB limit)
src/main/resources/models/custom_convnext_embeddings.onnx
