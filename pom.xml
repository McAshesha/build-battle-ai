<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.ashesha</groupId>
    <artifactId>buildbattleai</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>BuildBattleAI</name>
    <description>A competitive mini-game on building and explaining the buildings of AI</description>
    <url>https://github.com/McAshesha/BuildBattleAI</url>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <plugin.main>ru.ashesha.buildBattleAI.BuildBattleAI</plugin.main>
        <plugin.authors>[ McAshesha ]</plugin.authors>
        <plugin.prefix>BBAI</plugin.prefix>
        <!-- JAR signing — skipped by default; activate with -Psign -->
        <jarsigner.skip>true</jarsigner.skip>
        <!-- ProGuard obfuscation — skipped by default; activate with -Pobfuscate-light / -Pobfuscate / -Pobfuscate-heavy -->
        <proguard.skip>true</proguard.skip>
        <proguard.config.level>${project.basedir}/proguard/light.pro</proguard.config.level>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.44</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- E2E and ML integration tests are heavy (subprocess server boot,
                         107 MiB ONNX model load) and gated by system properties.
                         Exclude them from the default test run; the -Pe2e / -Pml-it
                         profiles re-include them by flipping the gating properties. -->
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                        <exclude>**/MLIntegrationTest.java</exclude>
                    </excludes>
                    <argLine>
                        -Dnet.bytebuddy.experimental=true
                        --add-opens=java.base/jdk.internal.access=ALL-UNNAMED
                        --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED
                        --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
                        --add-opens=java.base/sun.util.calendar=ALL-UNNAMED
                        --add-opens=java.base/sun.reflect.generics.reflectiveObjects=ALL-UNNAMED
                        --add-opens=java.base/java.io=ALL-UNNAMED
                        --add-opens=java.base/java.nio=ALL-UNNAMED
                        --add-opens=java.base/java.net=ALL-UNNAMED
                        --add-opens=java.base/java.util=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED
                        --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
                        --add-opens=java.base/java.lang=ALL-UNNAMED
                        --add-opens=java.base/java.lang.invoke=ALL-UNNAMED
                        --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens=java.base/java.math=ALL-UNNAMED
                        --add-opens=java.base/java.time=ALL-UNNAMED
                        --add-opens=java.base/java.text=ALL-UNNAMED
                        --add-opens=java.sql/java.sql=ALL-UNNAMED
                        --add-opens=java.management/com.sun.jmx.mbeanserver=ALL-UNNAMED
                        --add-opens=java.management/sun.management=ALL-UNNAMED
                        --add-opens=java.desktop/java.awt.font=ALL-UNNAMED
                        --add-opens=jdk.management/com.sun.management.internal=ALL-UNNAMED
                        --add-opens=jdk.internal.jvmstat/sun.jvmstat.monitor=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <!-- Shared relocations applied to both executions -->
                <configuration>
                    <relocations>
                        <relocation>
                            <pattern>com.cryptomorin.xseries</pattern>
                            <shadedPattern>ru.ashesha.buildBattleAI.libs.xseries</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.github.retrooper.packetevents</pattern>
                            <shadedPattern>ru.ashesha.buildBattleAI.libs.packetevents</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>io.github.retrooper.packetevents</pattern>
                            <shadedPattern>ru.ashesha.buildBattleAI.libs.packetevents.impl</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>net.kyori</pattern>
                            <shadedPattern>ru.ashesha.buildBattleAI.libs.kyori</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>com.google.gson</pattern>
                            <shadedPattern>ru.ashesha.buildBattleAI.libs.gson</shadedPattern>
                        </relocation>
                    </relocations>
                </configuration>
                <executions>
                    <!-- 1) Lite JAR: without Ignite (attached artifact, does not replace main) -->
                    <execution>
                        <id>shade-lite</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>lite</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.apache.ignite:*</exclude>
                                    <exclude>javax.cache:*</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                    <!-- 2) Full JAR: with Ignite shaded (replaces main artifact) -->
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- ProGuard obfuscation — placed between shade and jarsigner so
                 the signed/copied JARs are already obfuscated.
                 Skipped by default; use -Pobfuscate-light / -Pobfuscate / -Pobfuscate-heavy. -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.6.1</version>
                <executions>
                    <execution>
                        <id>proguard</id>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${proguard.skip}</skip>
                    <obfuscate>true</obfuscate>
                    <!-- Process the shaded main JAR in-place -->
                    <injar>${project.build.finalName}.jar</injar>
                    <outjar>${project.build.finalName}.jar</outjar>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <!-- Dependencies are already inside the shaded JAR -->
                    <includeDependency>false</includeDependency>
                    <!-- Mapping file for stack trace deobfuscation -->
                    <mappingFileName>proguard-mapping.txt</mappingFileName>
                    <!-- Base keep rules (shared by all levels) -->
                    <proguardInclude>${project.basedir}/proguard/base.pro</proguardInclude>
                    <!-- Level-specific config, selected via profile property -->
                    <options>
                        <option>@${proguard.config.level}</option>
                    </options>
                    <!-- JDK 21 base module for core types (java.lang.Object, etc.).
                         JDK 25 jmods use class version 69 which ProGuard
                         cannot read, so we reference JDK 21 instead. -->
                    <libs>
                        <lib>${user.home}/Library/Java/JavaVirtualMachines/ms-21.0.10/Contents/Home/jmods/java.base.jmod</lib>
                    </libs>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.9.1</version>
                    </dependency>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-core</artifactId>
                        <version>9.3.2</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- JAR signing — placed between proguard and antrun so the copied
                 JARs are already signed. Skipped by default; use -Psign to activate. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jarsigner-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>sign-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>${jarsigner.skip}</skip>
                    <keystore>${jarsigner.keystore}</keystore>
                    <alias>${jarsigner.alias}</alias>
                    <storepass>${jarsigner.storepass}</storepass>
                    <keypass>${jarsigner.keypass}</keypass>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${project.basedir}/Servers/1.21/plugins"
                                      overwrite="true" />
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${project.basedir}/Servers/1.8/plugins"
                                      overwrite="true" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <!-- Text resources go through Maven resource filtering so that
                 plugin.yml / config.yml can read ${plugin.*} values from pom.xml.
                 Binary model files MUST be excluded — Maven filtering reads
                 through a platform-encoded Reader and would silently corrupt
                 the ONNX bytes. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>models/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>models/**</include>
                </includes>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
        <!-- PaperMC repository hosts paper-api, which MockBukkit needs at test scope. -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <profiles>
        <!-- Activate with: mvn clean package -Psign -Djarsigner.keystore=/path/to/keystore.jks
                                                      -Djarsigner.alias=bbai
                                                      -Djarsigner.storepass=<pass>
                                                      -Djarsigner.keypass=<pass>
             Generate a keystore once:
               keytool -genkeypair -alias bbai -keyalg RSA -keysize 2048 \
                       -validity 3650 -keystore keystore.jks -->
        <profile>
            <id>sign</id>
            <properties>
                <jarsigner.skip>false</jarsigner.skip>
            </properties>
        </profile>
        <!--
             End-to-end test profile.

             Activates the JUnit drivers under `src/test/java/.../e2e/` which
             spawn a real Paper / Purpur server as a subprocess, watch its
             stdout for plugin enable markers, and exercise a command.
             Requires that the plugin JAR has already been built (the antrun
             step of `mvn package` copies it into Servers/<v>/plugins/
             automatically) and that the Servers/1.8 + Servers/1.21
             directories are checked out locally.

             Run with:
               mvn package          # build & copy plugin into Servers/<v>/plugins
               mvn test -Pe2e       # actually exercise both servers
        -->
        <profile>
            <id>e2e</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- Re-include the e2e tests excluded by the default config. -->
                            <excludes>
                                <exclude>**/MLIntegrationTest.java</exclude>
                            </excludes>
                            <includes>
                                <include>**/e2e/**Test.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <bbai.e2e>true</bbai.e2e>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
             Real-model ML integration profile.

             Boots the bundled ONNX ConvNeXt-Tiny embedder via ORT and runs
             a single forward pass. Slow (~10 s cold-start) so excluded from
             the default `mvn test` run. Catches build-time regressions in
             which Maven filtering or shading silently corrupts the model
             file — none of the disabled-mode unit tests can detect this.

             Run with:
               mvn test -Pml-it
        -->
        <profile>
            <id>ml-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/e2e/**</exclude>
                            </excludes>
                            <includes>
                                <include>**/MLIntegrationTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <bbai.ml-it>true</bbai.ml-it>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
             JMH micro-benchmark profile.

             Adds src/jmh/java as a test source root, pulls in the JMH
             core + annotation processor under test scope, and exposes
             `mvn -Pbench exec:java -Dexec.mainClass=org.openjdk.jmh.Main`
             as the run entry point. Benchmarks live under
             `ru.ashesha.buildBattleAI.bench.*` — `RendererBenchmark`,
             `PaletteBenchmark`, `MlQueueBenchmark`.

             Run with:
               mvn test-compile -Pbench
               mvn -Pbench exec:java -Dexec.mainClass=org.openjdk.jmh.Main \
                   -Dexec.args="ru.ashesha.buildBattleAI.bench.RendererBenchmark"
        -->
        <profile>
            <id>bench</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-jmh-source</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/jmh/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <annotationProcessorPaths combine.children="append">
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>1.37</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>1.37</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-generator-annprocess</artifactId>
                    <version>1.37</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- Obfuscation profiles — rename only / rename+shrink+optimize / maximum -->
        <profile>
            <id>obfuscate-light</id>
            <properties>
                <proguard.skip>false</proguard.skip>
                <proguard.config.level>${project.basedir}/proguard/light.pro</proguard.config.level>
            </properties>
        </profile>
        <profile>
            <id>obfuscate</id>
            <properties>
                <proguard.skip>false</proguard.skip>
                <proguard.config.level>${project.basedir}/proguard/standard.pro</proguard.config.level>
            </properties>
        </profile>
        <profile>
            <id>obfuscate-heavy</id>
            <properties>
                <proguard.skip>false</proguard.skip>
                <proguard.config.level>${project.basedir}/proguard/heavy.pro</proguard.config.level>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- MockBukkit must appear BEFORE the bukkit provider so its paper-api wins
             on the test classpath (per MockBukkit README guidance). Test scope only —
             never reaches the shaded JAR.

             Version pinned to 4.50.0 — paired with paper-api 1.21.5. Newer MockBukkit
             releases (4.60+) target paper-api 1.21.6+ which introduces the
             `minecraft:dialog` registry; MockBukkit's bundled registry JSON does not
             include data for that registry, causing `RegistryAccessMock.<clinit>` to
             throw `InternalDataLoadException` on any test that touches Bukkit Registry.
             Older releases (4.70+) also drop JUnit 5 compatibility.
             4.50.0 + 1.21.5 is the sweet spot for JUnit 5.10 + working RegistryAccess. -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>4.50.0</version>
            <scope>test</scope>
        </dependency>
        <!-- paper-api MUST match the version MockBukkit was built against. Our main
             code compiles against spigot-api 1.21.8 (provided), but the Bukkit
             interface surface is unchanged across 1.21.x patches — only Paper-only
             extensions differ, and those are not used in main code. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.5-R0.1-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.12.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.44</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>13.6.0</version>
        </dependency>
        <!-- Force adventure-api 4.25.0 to win dependency mediation:
             PacketEvents transitively pulls 4.21.0, but
             net.kyori.adventure.text.object.ObjectContents was only added in
             4.25.0. Without it the plugin fails to enable on MC 1.21.6+ with
             NoClassDefFoundError when PacketEvents decodes item components
             (e.g. minecraft:item_name). -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.25.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.25.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.ignite</groupId>
            <artifactId>ignite-core</artifactId>
            <version>2.16.0</version>
            <scope>compile</scope>
        </dependency>
        <!-- Bundled & relocated Gson — Bukkit/Spigot ships a much older Gson
             (e.g. Paper 1.8.8 → 2.2.4) lacking TypeToken.getParameterized(...)
             used by LocalRepository. Shading our own 2.11.0 under
             ru.ashesha.buildBattleAI.libs.gson sidesteps the server's copy. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
            <scope>compile</scope>
        </dependency>
        <!-- ONNX Runtime for native ResNet50 embedding inference.
             Ships CPU on all platforms + CoreML on macOS (arm64/x86_64) +
             DirectML on Windows out of the box. The companion artifact
             `onnxruntime_gpu` adds CUDA bindings but bloats the JAR by ~600MB
             and would tie the JAR to a specific CUDA toolkit, so we keep the
             plain artifact and let CUDA fail gracefully when probing providers. -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.21.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
